APP_NAME=智泳云枢业务后端
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://swim:swim@localhost:5432/swim_analysis

UPLOAD_DIR=uploads

MODEL_SERVICE_URL=http://127.0.0.1:8100
MODEL_SERVICE_TIMEOUT_SECONDS=120

JWT_SECRET_KEY=please-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# AI-assisted report interpretation is opt-in. Keep both switches false until
# privacy review, provider credentials, and coach pilot approval are complete.
AI_INTERPRETATION_ENABLED=false
AI_INTERPRETATION_AUTO_GENERATE=false
AI_INTERPRETATION_PROVIDER=qwen
AI_INTERPRETATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# qwen-plus is text-only here. Set a Qwen visual model only after its image
# input and JSON output support have been verified in the target workspace.
AI_INTERPRETATION_MODEL=qwen-plus
AI_INTERPRETATION_API_KEY=
AI_INTERPRETATION_TIMEOUT_SECONDS=120
AI_INTERPRETATION_MAX_RETRIES=2
AI_INTERPRETATION_TEMPERATURE=0.0
AI_INTERPRETATION_MAX_INPUT_CHARS=24000
# Omit AI_INTERPRETATION_MAX_OUTPUT_TOKENS to use the provider default.
AI_INTERPRETATION_THINKING_ENABLED=true
AI_INTERPRETATION_VISUAL_ENABLED=false
AI_INTERPRETATION_MODEL_SUPPORTS_VISION=false
AI_INTERPRETATION_MODEL_SUPPORTS_STRUCTURED_OUTPUT=true
AI_INTERPRETATION_MAX_EVIDENCE_IMAGES=9
AI_INTERPRETATION_MAX_EVIDENCE_BYTES=6000000
AI_INTERPRETATION_MAX_EVIDENCE_IMAGE_PIXELS=2000000
AI_INTERPRETATION_MAX_CURVE_POINTS=48
AI_INTERPRETATION_MAX_KNOWLEDGE_ITEMS=6
AI_INTERPRETATION_RATE_LIMIT_PER_HOUR=10
AI_INTERPRETATION_STALE_AFTER_SECONDS=600
AI_INTERPRETATION_MAX_ESTIMATED_COST_USD=0.02
# Update these prices whenever the selected provider changes its billing.
AI_INTERPRETATION_INPUT_COST_PER_MILLION_TOKENS=0.14
AI_INTERPRETATION_OUTPUT_COST_PER_MILLION_TOKENS=0.28
AI_INTERPRETATION_DEBUG_RETENTION=false
